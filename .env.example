# Binance API Credentials
# Create these at https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Webhook Security
# This should be a strong, unique password that matches what you configure in TradingView
WEBHOOK_SECRET=your_secure_webhook_secret_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO